; 對外(iPhone)改由 Flexisip 推播閘道接(__TAILSCALE_IP__:5060,見 flexisip/),
; Asterisk 只綁 loopback:iPhone 的 REGISTER/INVITE 都經 Flexisip 轉進來,
; baresip(6001)也在同機 127.0.0.1。對外完全不監聽 → 無 toll fraud 暴露面。
[transport-udp-local]
type=transport
protocol=udp
bind=127.0.0.1:5060

[endpoint-tpl](!)
type=endpoint
context=from-internal
disallow=all
allow=ulaw
allow=alaw
allow=g722
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes

[auth-tpl](!)
type=auth
auth_type=userpass

[aor-tpl](!)
type=aor
max_contacts=1
remove_existing=yes

; --- 6001 baresip (HFP 橋) ---
[6001](endpoint-tpl)
auth=6001-auth
aors=6001
callerid=HFP Bridge <6001>

[6001-auth](auth-tpl)
username=6001
password=__SIP_BARESIP_PASS__

[6001](aor-tpl)

; --- 6002 iPhone ---
[6002](endpoint-tpl)
auth=6002-auth
aors=6002
callerid=iPhone <6002>
; Contact 已被 Flexisip 換成自己(含 CtRt 路由參數),別再依封包來源改寫
rewrite_contact=no

[6002-auth](auth-tpl)
username=6002
password=__SIP_IPHONE_PASS__

[6002](aor-tpl)
; Flexisip 會加 Path 頭,但官方 Linphone 不宣告 Supported: path → 不關會回 420
support_path=no
; iOS 推播:Flexisip 每 30 分鐘用背景推播叫 App 續約,註冊可放長
default_expiration=604800
maximum_expiration=604800
remove_unavailable=no

; 全域 SIP ACL(pjsip 的 type=acl section 會自動套用成全域來源過濾,不需掛 endpoint)。
; 只放行:本機 loopback(baresip 6001,源為 127.0.0.1)+ Tailscale 網段(iPhone 6002)。
; 擋掉實體 LAN/公網掃描器冒用分機(toll fraud)。auth(密碼)仍為主要身分驗證,ACL 是來源層。
[acl-sources]
type=acl
deny=0.0.0.0/0
permit=127.0.0.0/8
permit=100.64.0.0/10
