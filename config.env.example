# === SMS 橋接設定範本 — 複製成 config.env 並填值 ===

# --- Discord ---
# #簡訊 頻道 ID 與該頻道的 incoming webhook URL
SMS_CHANNEL_ID=
SMS_DISCORD_WEBHOOK=

# --- 手機 SMS gateway (httpSMS: https://httpsms.com) ---
# app 內取得 API key；FROM 填你的門號 (E.164, 例 +886912345678)
HTTPSMS_API_KEY=
HTTPSMS_FROM=+886

# 出站輪詢間隔秒數
POLL_INTERVAL=4

# --- 語音 (BlueALSA + oFono) ---
# 你手機的藍牙 MAC (bluetoothctl devices 查)
PHONE_MAC=XX:XX:XX:XX:XX:XX
